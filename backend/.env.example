# Copy file ini jadi .env, lalu isi nilainya.
# JANGAN commit .env ke git.

# JWT — generate sekali dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=ganti-dengan-hasil-generate-di-atas
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Resend (email service) — daftar gratis di https://resend.com
# Free tier: 3000 email/bulan, 100/hari
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# URL frontend untuk link reset password di body email
FRONTEND_URL=http://localhost:8000/static
